{
  "name": "agentdock-ui",
  "version": "0.1.0",
  "description": "Source-copy installer for AgentDock UI components",
  "license": "MIT",
  "type": "module",
  "private": false,
  "files": [
    "dist"
  ],
  "bin": {
    "agentdock-ui": "./dist/index.js"
