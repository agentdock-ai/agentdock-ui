{
  "name": "@agentdock-ai/react",
  "version": "0.1.0",
  "description": "React primitives for consuming AgentDock event streams",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "sideEffects": ["./dist/styles.css"],
  "engines": { "node": ">=22" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/ui": {
      "types": "./dist/components/ui/index.d.ts",
      "import": "./dist/components/ui/index.js"
    },
    "./components/message": {
      "types": "./dist/components/message/index.d.ts",
      "import": "./dist/components/message/index.js"
    },
    "./components/chat": {
      "types": "./dist/components/chat/index.d.ts",
      "import": "./dist/components/chat/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@agentdock-ai/ui-core": "0.1.0",
    "@radix-ui/react-slot": "^1.3.3",
    "lucide-react": "^1.46.0",
    "radix-ui": "^1.6.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
